      "conve:diagnostics_engine_status"
    ],
    "accept": "application/json",
    "type": "info",
    "refreshDelay": 15,
    "cmds": {
      "engineCoolantLevelWarning": "coolantLevel",
      "oilLevelWarning": "oilLevel"
    }
  },
