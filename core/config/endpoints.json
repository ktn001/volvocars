    }
  },
  "LOCK": {
    "API": "Connected-vehicle",
    "scopes": [
      "openid",
      "conve:lock"
    ],
    "type": "action",
    "cmd": "lock" 
  },
  "LOCK_REDUCED_GUARD": {
    "API": "Connected-vehicle",
    "scopes": [
