    "API": "Connected-vehicle",
    "scopes": [
      "openid",
      "conve:honk_flash"
    ],
    "type": "action",
    "cmd": "honk_flash" 
  },
  "location": {
    "API": "Location",
    "url": "https://api.volvocars.com/location/v1/vehicles/#VIN#/location",
