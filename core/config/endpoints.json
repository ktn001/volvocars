    "API": "Connected-vehicle",
    "scopes": [
      "openid",
      "conve:engine_start_stop"
    ],
    "type": "action",
    "cmd": "engineStart" 
  },
  "ENGINE_STOP": {
    "API": "Connected-vehicle",
    "scopes": [
      "openid",
      "conve:engine_start_stop"
    ],
    "type": "action",
    "cmd": "engineStop" 
  },
  "engine_status": {
    "API": "Connected-vehicle",
    "url": "https://api.volvocars.com/connected-vehicle/v2/vehicles/#VIN#/engine-status",
